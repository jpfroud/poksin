{
  "name": "poksin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24.22.3 || ^26.13.1"
  },
  "scripts": {
    "dev": "vite",
    "start": "node dist/server/main.js",
    "build": "npm run build:server && vite build",
    "build:server": "tsc --project tsconfig.server.json",
    "format": "prettier --write index.html src tests/server tests/e2e *.config.* tsconfig*.json package.json",
    "format:check": "prettier --check index.html src tests/server tests/e2e *.config.* tsconfig*.json package.json",
    "lint": "eslint src tests/server tests/e2e *.config.*",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:hooks": "node --test tests/gstack-hooks.test.cjs",
    "test:deployment": "node --test tests/deployment.test.cjs",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "check:quick": "npm run format:check && npm run lint && npm run typecheck && npm run test:hooks && npm run test:deployment && npm test",
    "check": "npm run check:quick && npm run test:coverage && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource-variable/dm-sans": "5.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@types/node": "24.4.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
